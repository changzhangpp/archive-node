# 归档机地址（不带 /archive 后缀）
ARCHIVE_URL=https://8100-572cc49902f2ee46.monkeycode-ai.live
# 归档 key：向归档机管理员领取，勿提交到仓库
ARCHIVE_KEY=change-me
# 分片大小（字节，1024-131072），默认 48KB
ARCHIVE_CHUNK_SIZE=49152
# 单请求超时与重试
ARCHIVE_TIMEOUT=30
ARCHIVE_RETRIES=4
ARCHIVE_BACKOFF=0.8
# 是否校验证书（1=校验）
ARCHIVE_VERIFY_TLS=1

# HTTP 微服务可选配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8089
# 服务鉴权令牌；为空则无鉴权，仅限内网
SERVICE_TOKEN=
# 服务接收 body 上限（MB），0 为不限
SERVICE_MAX_MB=0
